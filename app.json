{
  "expo": {
    "name": "ChoreFlow",
    "slug": "choreflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choreflow.adhdapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1F5F9",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.choreflow.adhdapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1"
        }
      ],
      "expo-font"
    ]
  }
}
